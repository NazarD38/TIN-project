<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Skill</title>
    <link rel="stylesheet" href="/css/add.css">
</head>
<body>
<h1>Add New Skill</h1>

<form id="skillForm" action="/skills/add" method="POST">
    <label for="name">Name:</label>
    <input type="text" name="name" id="name" value="<%= name %>"><br>
    <div id="nameError" class="error-item"></div>

    <label for="description">Description:</label>
    <input type="text" name="description" id="description" value="<%= description %>"><br>
    <div id="descriptionError" class="error-item"></div>

    <label for="assassins">Assign to Assassins:</label>
    <select name="assassins[]" id="assassins" multiple>
        <% if (assassins && assassins.length > 0) { %>
            <% assassins.forEach(assassin => { %>
                <option value="<%= assassin.id %>" <%= (assassin.selected ? 'selected' : '') %>>
                    <%= assassin.name %>
                </option>
            <% }); %>
        <% } else { %>
            <option disabled>No assassins available</option>
        <% } %>
    </select><br>
    <div id="assassinsError" class="error-item"></div>

    <label for="notes">Notes:</label>
    <textarea name="notes" id="notes" rows="4" cols="50"><%= notes || '' %></textarea><br>
    <div id="notesError" class="error-item"></div>

    <button type="submit">Add Skill</button>
</form>
<script src="/validation/skillValidation.js"></script>
</body>
</html>
