<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= skill.name %> Details</title>
    <link rel="stylesheet" href="/css/detail.css">
</head>
<body>
<div class="weapon-details-container">
    <h1>Details for Skill: <%= skill.name %></h1>
    <div class="weapon-details-content">
        <p><strong>Name:</strong> <%= skill.name %></p>
        <p><strong>Description of skill:</strong> <%= skill.description %></p>
    </div>
    <div class="back-link">
        <a href="/skills">Back to Skill List</a>
    </div>
</div>
</body>
</html>
